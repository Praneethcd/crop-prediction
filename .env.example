# Keep credentials in .env; do not commit it. Existing app runs at http://127.0.0.1:5001.
AGMARKNET_API_KEY=
# Obtain your own API key from data.gov.in.
SECRET_KEY=
# Optional alternative database path, otherwise the existing agripredict.db is used.
# AGRIPREDICT_DATABASE=/absolute/path/agripredict.db
CROP_MONITOR_ENABLED=1
CROP_MONITOR_INTERVAL_SECONDS=900
HOST=127.0.0.1
PORT=5001
# Optional alternative trained model artifacts (defaults are included).
# DISEASE_MODEL_PATH=/absolute/path/leaf_classifier.pt
# DISEASE_LABELS_PATH=/absolute/path/metadata.json
# Production admin bootstrap only; no default admin password is created in production.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Production deploys supply SECRET_KEY and set APP_ENV=production.
# AGRIPREDICT_INSTANCE_PATH=/data/instance
